# Copia este fichero a .env y rellena tus credenciales.
# El .env NO se sube al repositorio (está en .gitignore).

# Broker MQTT (por ejemplo, una cuenta gratuita de HiveMQ Cloud)
MQTT_HOST=TU-BROKER.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USER=tu_usuario
MQTT_PASS=tu_password

# Grupo por defecto para el simulador y el visualizador
GRUPO=G0
G0_GROUP=G0
